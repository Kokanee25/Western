 "later_lines": [
  "earl: \"Three. And make 'em good.\"",
  "drifter: \"A pair of threes. Don't all thank me at once.\"",
  "earl: \"These cards have been against me since Christmas.\"",
  "drifter: \"Three. Don't spare me.\"",
  "earl: \"Three.\"",
  "drifter: \"Bet two bits more'n it's worth.\"",
  "earl: \"See you.\"",
  "drifter: \"A pair of jacks. Read 'em and weep.\"",
  "drifter: \"Cut 'em thin, deal 'em true.\"",
  "loudmouth: \"Ain't no sheriff tonight, boys!\"",
  "drifter: \"Three, and quit smiling.\"",
  "earl: \"Two pair, queens and eights. Now ain't that something.\"",
  "drifter: \"You're a lucky old man, Earl.\"",
  "earl: \"Deal's mine. Watch my hands, if you like.\"",
  "drifter: \"A pair of nines.\"",
  "drifter: \"Five-card draw. Ante up.\"",
  "drifter: \"A dollar.\"",
  "earl: \"Don't mind if I do.\"",
  "drifter: \"Nobody wants it? I'll mind it for you.\"",
  "miner: \"Look what the wind blew in.\"",
  "earl: \"My deal. Ante up, boys.\"",
