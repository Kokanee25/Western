 "later_lines": [
  "drifter: \"Sit down or move along, mister.\"",
  "earl: \"I'll bet.\"",
  "drifter: \"I'll see that.\"",
  "earl: \"A pair of kings. Clean deck, boys. Clean as Sunday.\"",
  "earl: \"Five-card. Same as ever.\"",
  "drifter: \"Three. Don't spare me.\"",
  "drifter: \"Bet.\"",
  "drifter: \"A pair of aces, gents.\"",
  "drifter: \"Let's see if these are any kinder.\"",
  "drifter: \"Don't mind if I do.\"",
  "earl: \"A dollar.\"",
  "drifter: \"A pair of aces. Read 'em.\"",
  "earl: \"My deal. Ante up, boys.\"",
  "drifter: \"Three, and quit smiling.\"",
  "drifter: \"A pair of queens. Thank you kindly.\"",
  "stranger: \"Evening. Mind if I sit in a while?\"",
  "drifter: \"Five-card draw. Ante up.\"",
  "cody: \"Earl, you cheating son of a bitch!\"",
  "stranger: \"Don't move, friend. Whatever happens next, you sit still.\"",
  "earl: \"Now, Cody, I never...\"",
  "cody: \"Ain't no law left in this valley to save you now, Earl.\"",
  "barkeep: \"Jesus, Cody, my chair!\"",
  "stranger: \"You didn't see a thing tonight. Nobody did. Remember that.\"",
  "barkeep: \"Somebody ought to fetch the... hell. Ain't nobody left to fetch.\"",
  "runner: \"Harlan! Doc's asking for you. Says the sheriff's sinking.\""
