+## He comes up clear of what lies round him (his chair's wreck, a table): of the ways he could
+## face as he rises (RISE_TURNS, degrees from the way he lies facing), the one with least in the way
+## of his knees and feet in the stages' kneeling and standing places, the least turn, and his hat in
+## reach if it's down near him. Before this he knelt into the chair he'd gone over with, and rose
+## through it (its pieces don't collide with him rising: _spare_rubble).
+const RISE_TURNS := [0.0, 35.0, -35.0, 70.0, -70.0]
+## How near (m) the place he kneels on one knee his hat must lie for him to pick it up from there.
+const HAT_REACH := 0.75
+## The settle on his feet: segment -> how fast it swings on (degrees/s, as a flinch).
+const RISE_SETTLE := {&"upper_arm_r": Vector3(140, 0, 30), &"upper_arm_l": Vector3(110, 0, -30),
+		&"forearm_r": Vector3(160, 0, 0), &"forearm_l": Vector3(130, 0, 0), &"chest": Vector3(-35, 0, 0)}
+var _rise_hat: RigidBody3D  ## the hat he's going for, or has in his hand
+var _rise_hand := "r"
+var _hat_in_hand := false
+
+
+func _rise_heading(at: Vector3, to: Vector3, stages: Array, hat: RigidBody3D) -> Vector3:
+	var best := to
+	var best_score := INF
+	for deg: float in RISE_TURNS:
+		var dir := to.normalized().rotated(Vector3.UP, deg_to_rad(deg))
+		var score := _rise_blocked(at, dir, stages) + absf(deg) / 140.0
+		if hat and _hat_ahead(at, dir, stages, hat) == INF:
+			score += 0.4
+		if score < best_score:
+			best_score = score
+			best = dir
+	return best
+
+
+## How far ahead (along `dir` from `at`) he'd kneel to pick up `hat`, his hand reaching HAT_REACH
+## ahead of his knee, shuffling at most HAT_SHUFFLE on from where he'd kneel anyway; INF if it's
+## off to the side or further.
+const HAT_SHUFFLE := 0.6
+
+
+func _hat_ahead(at: Vector3, dir: Vector3, stages: Array, hat: RigidBody3D) -> float:
+	var kneel := INF
+	for st: Array in stages:
+		if st[0] == &"kneel_up":
+			kneel = float(st[3])
+	if kneel == INF:
+		return INF
+	var rel := _flat(hat.global_position) - _flat(at)
+	var along := rel.dot(dir)
+	if absf(rel.dot(dir.cross(Vector3.UP))) > 0.4:
+		return INF
+	var want := along - HAT_REACH * 0.6
+	if want < kneel - 0.2 or want > kneel + HAT_SHUFFLE:
+		return INF
+	return maxf(want, kneel)
+
+
+func _flat(p: Vector3) -> Vector3:
+	return Vector3(p.x, 0.0, p.z)
+
+
+## How much is in the way of his knees and feet coming up facing `dir`: things (not the floor) in
+## small balls along where his knees, shins and feet go, at shin and knee height.
+func _rise_blocked(at: Vector3, dir: Vector3, stages: Array) -> float:
+	var space := get_world_3d().direct_space_state
+	var ball := SphereShape3D.new()
+	ball.radius = 0.1
+	var q := PhysicsShapeQueryParameters3D.new()
+	q.shape = ball
+	q.collision_mask = Layers.WORLD
+	q.exclude = _own_rids()
+	var side := dir.cross(Vector3.UP)
+	var n := 0.0
+	var spots: Array[float] = [0.15]
+	for st: Array in stages:
+		if st[1] is Vector3 and st[1] == Vector3.ZERO and not spots.has(float(st[3])):
+			spots.append(float(st[3]))
+	for ahead in spots:
+		for across: float in [-0.15, 0.15]:
+			for up: float in [0.17, 0.4]:
+				q.transform = Transform3D(Basis(), at + dir * ahead + side * across + Vector3.UP * up)
+				for hit: Dictionary in space.intersect_shape(q, 4):
+					if hit.collider is RigidBody3D or hit.collider is StructureMember:
+						n += 1.0
+	return n
+
+
+## Rolling over off his back to come up the face-down way: onto his side (`roll`: +1 his right,
+## by the turn about his length), then onto his front.
+func _rise_roll_over(front: Array, roll := 1.0) -> Array:
+	var down := Basis(Vector3.RIGHT, -PI / 2.0)
+	var out: Array = [[&"lie_back", down * Basis(Vector3.UP, PI * 0.999), 0.4, 0.0],
+			[&"prone", down * Basis(Vector3.UP, roll * PI / 2.0), 0.7, 0.0]]
+	# Face down from the first he'd push back onto his knees, toward his feet: here that's where
+	# the wreck is, so he crawls on a little the way his head lies and comes up there.
+	out.append_array(_rise_crawl_on(front).slice(1))
+	return out
+
+
+## The face-down stages with him coming up a step on, the way his head lies, not pushed back
+## toward his feet.
+func _rise_crawl_on(front: Array) -> Array:
+	var out: Array = []
+	for st0: Array in front:
+		var st := st0.duplicate()
+		st[3] = absf(float(st[3])) + 0.1 if float(st[3]) != 0.0 else 0.0
+		out.append(st)
+	return out
+
+
+## His own hat lying about (knocked off: knock_hat_off), or null.
+func _my_hat() -> RigidBody3D:
+	if not hat_off or _hat_worn.is_empty():
+		return null
+	for h in get_tree().get_nodes_in_group(&"hats"):
+		if h is RigidBody3D and h.get_meta(&"hat_of", null) == self and not h.is_queued_for_deletion():
+			return h
+	return null
+
+
+## What he does in a stage besides its pose: picks up his hat, puts it on, or brushes the dirt off.
+func _rise_extras(stages: Array, at: Vector3, dir: Vector3, hat: RigidBody3D) -> void:
+	_rise_hat = null
+	_hat_in_hand = false
+	_rise_hand = "r" if _hand_free("r") else ("l" if _hand_free("l") else "")
+	var kneel := -1
+	for i in stages.size():
+		if stages[i][0] == &"kneel_up":
+			kneel = i
+	var last: Array = stages[-1]
+	var reach_ahead := _hat_ahead(at, dir, stages, hat) if hat else INF
+	if kneel >= 0 and _rise_hand != "" and reach_ahead != INF:
+		_rise_hat = hat
+		# The hand on the side it lies, if that one's free.
+		var across := (_flat(hat.global_position) - _flat(at)).dot(dir.cross(Vector3.UP))
+		var near := "r" if across >= 0.0 else "l"
+		if _hand_free(near):
+			_rise_hand = near
+		# He shuffles on his knee toward it, and comes up from there.
+		stages.insert(kneel + 1, [&"kneel_reach", Vector3.ZERO, 1.0, reach_ahead, &"reach_hat"])
+		for i in range(kneel + 2, stages.size()):
+			stages[i][3] = reach_ahead + (float(stages[i][3]) - float(stages[kneel][3]))
+		last = stages[-1]
+		stages.append([last[0], last[1], 1.1, last[3], &"don_hat"])
+	elif _rise_hand != "":
+		stages.append([last[0], last[1], 0.8, last[3], &"brush"])
+
+
+func _rise_act(act: StringName, f: float) -> void:
+	var side := _rise_hand
+	if side == "":
+		return
+	var other := "l" if side == "r" else "r"
+	var fwd := -global_basis.z
+	match act:
+		&"reach_hat":
+			if _rise_hat == null or not is_instance_valid(_rise_hat):
+				return
+			if not _hat_in_hand:
+				# Down to it, his palm onto its crown; he has it once his hand's there, or gives it up.
+				reach_to(side, _rise_hat.global_position + Vector3.UP * 0.04, Vector3.UP, smoothstep(0.0, 0.45, f))
+				if f >= 0.35 and palm(side).distance_to(_rise_hat.global_position) < 0.32:
+					_take_hat(side)
+				elif f >= 0.85:
+					_rise_hat = null
+			else:
+				_hat_to_hand()
+		&"don_hat":
+			if not _hat_in_hand or _rise_hat == null or not is_instance_valid(_rise_hat):
+				return
+			_hat_to_hand()
+			var hip := (pivots[StringName("thigh_" + other)] as Node3D).global_position
+			var head := (pivots[&"head"] as Node3D).global_position
+			if f < 0.4:
+				# A slap of it against his thigh to knock the dust out, twice ...
+				var slap := hip + fwd * 0.12 + Vector3.DOWN * (0.12 + 0.06 * sin(f / 0.4 * TAU * 2.0))
+				reach_to(side, slap, -fwd, sin(f / 0.4 * PI) * 0.9)
+			elif f < 0.9:
+				# ... then up and onto his head.
+				reach_to(side, head + Vector3.UP * 0.17 + fwd * 0.03, Vector3.UP, sin((f - 0.4) / 0.5 * PI * 0.5))
+				if f >= 0.82:
+					wear_hat(_rise_hat)
+					_hat_in_hand = false
+					_rise_hat = null
+		&"brush":
+			# The dust brushed off his other sleeve and down his thigh, twice.
+			var sh := (pivots[StringName("upper_arm_" + other)] as Node3D).global_position
+			var hip := (pivots[StringName("thigh_" + other)] as Node3D).global_position
+			var sweep := 0.5 - 0.5 * cos(f * TAU * 2.0)
+			var p := sh.lerp(hip + Vector3.DOWN * 0.15, sweep) + fwd * 0.1
+			reach_to(side, p, -fwd, sin(f * PI))
+
+
+## The hat into his hand: it rides there (no longer a loose thing) until he puts it on.
+func _take_hat(side: String) -> void:
+	var h := _rise_hat
+	h.freeze_mode = RigidBody3D.FREEZE_MODE_KINEMATIC
+	h.freeze = true
+	h.collision_layer = 0
+	h.collision_mask = 0
+	h.reparent(parts[StringName("hand_" + side)] as Node3D, true)
+	_hat_in_hand = true
+
+
+## Picked up, the hat comes the rest of the way into his hand (by the brim, under the palm) over a
+## few ticks: the reach brings his palm within a hand-span of it, not onto it.
+const HAT_IN_HAND := Vector3(0.0, -0.06, 0.04)
+
+
+func _hat_to_hand() -> void:
+	if _rise_hat and is_instance_valid(_rise_hat):
+		_rise_hat.position = _rise_hat.position.lerp(HAT_IN_HAND, 0.2)
+
+
+## Whatever stopped him putting it on, a hat in his hand is let fall where he stands.
+func _drop_held_hat() -> void:
+	if _hat_in_hand and is_instance_valid(_rise_hat):
+		var host := get_parent() if get_parent() else self
+		_rise_hat.reparent(host, true)
+		_rise_hat.collision_layer = Layers.DEBRIS
+		_rise_hat.collision_mask = Layers.DEBRIS_MASK
+		_rise_hat.freeze = false
+	_hat_in_hand = false
+	_rise_hat = null
+
+
+## His hat (`knock_hat_off`'s, lying about) back on his head: drawn as it was worn, and its hitbox
+## back. False if he's no hat off.
+func wear_hat(hat: Node3D) -> bool:
+	if not hat_off or _hat_worn.is_empty():
+		return false
+	for key: String in _hat_worn:
+		var e: Array = _hat_worn[key]
+		skin_meshes[key] = e[0]
+		(e[0] as MeshInstance3D).visible = e[1]
+	for shape_name: String in _hat_merged:
+		if _merged.has(shape_name) and is_instance_valid(_merged[shape_name]):
+			(_merged[shape_name] as MeshInstance3D).visible = _hat_merged[shape_name]
+	_hat_worn.clear()
+	_hat_merged.clear()
+	hat_off = false
+	_build_hat_box()
+	if hat and is_instance_valid(hat):
+		hat.queue_free()
+	return true
+
+
