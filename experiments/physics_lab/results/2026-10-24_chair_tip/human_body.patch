+	var side_off := back.cross(Vector3.UP) * (0.1 if side == "r" else -0.1)
+	return Vector3(at.x, global_position.y, at.z) + back * ahead + side_off
+
+
+func kicking() -> bool:
+	return not _kick.is_empty()
