+
+## Where to stand to kick `at` (world, on his ground) with his `side` leg, coming from `from`: his
+## leg's reach out from the hip at that height, back along the way he comes.
+func kick_spot(at: Vector3, from: Vector3, side := "r") -> Vector3:
+	var hip_h := (pivots[StringName("thigh_" + side)] as Node3D).global_position.y - global_position.y
