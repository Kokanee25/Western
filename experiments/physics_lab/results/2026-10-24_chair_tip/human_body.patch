+## Kick `at` (world) with his `side` leg. False if he can't (down, rising, playing a clip, on one
+## leg already) or it's out of his leg's reach from where he stands (kick_spot says where to stand).
+func kick(at: Vector3, how := &"front", side := "r") -> bool:
+	if limp or rising or prone or _clip != null or not _kick.is_empty() or not physiology.can_stand():
+		return false
+	# Square to it from the kicking hip (the boot goes out from there, not from his middle); turning
+	# him moves the hip, so twice.
+	for i in 2:
+		var h := (pivots[StringName("thigh_" + side)] as Node3D).global_position
+		face(at + (global_position - h) * Vector3(1, 0, 1))
