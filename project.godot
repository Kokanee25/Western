; Engine configuration file.
; Hand-edited is fine: keep it tidy, one setting per line.

config_version=5

[application]

config/name="Salt Creek"
config/description="A first-person immersive-sim Western set in one frontier town, 1882."
config/version="0.0.1-m0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
Settings="*res://src/autoload/settings.gd"
Controls="*res://src/autoload/controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input_devices]

pointing/emulate_mouse_from_touch=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[shader_globals]

tile_light={
"type": "float",
"value": 1.0
}
tile_ragged={
"type": "float",
"value": 0.0
}
min_square_px={
"type": "float",
"value": 2.0
}

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/decals/filter=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
