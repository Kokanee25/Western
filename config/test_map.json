    "test_valley.gd",
    "test_save_game.gd",
    "test_game_reset.gd",
    "test_native.gd",
    "test_test_shards.gd",
    "test_test_map.gd",
    "test_leak_check.gd",
    "test_docs_size.gd"
  ],
